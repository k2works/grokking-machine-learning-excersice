{
  "name": "",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "gulp spec",
    "journal": "gulp journal:generate",
    "docs:serve": "gulp docsServe",
    "docs:stop": "gulp mkdocs:stop",
    "docs:build": "gulp docsBuild",
    "docs:notebooks": "gulp notebooks:sync",
    "notebooks:check": "gulp notebooks:check",
    "manual:build": "gulp manual:build",
    "vault:encrypt": "gulp vault:encrypt",
    "vault:decrypt": "gulp vault:decrypt",
    "vault:view": "gulp vault:view",
    "vault:rekey": "gulp vault:rekey",
    "claude:yolo": "claude --dangerously-skip-permissions",
    "copilot:yolo": "copilot --allow-all-tools",
    "codex:yolo": "codex --yolo",
    "gemini:yolo": "gemini --yolo",
    "lint": "gulp notebooks:check && npm run lint:docs && npm run lint:python",
    "lint:docs": "markdownlint-cli2",
    "lint:python": "cd apps/grokking-ml-python && uv run ruff check .",
    "test": "npm run test:python && npm run test:kotlin && npm run test:fsharp",
    "test:python": "cd apps/grokking-ml-python && uv run pytest -q",
    "test:kotlin": "cd apps/grokking-ml-kotlin && ./gradlew test",
    "test:fsharp": "cd apps/grokking-ml-fsharp && dotnet test",
    "test:e2e": "node ops/scripts/no-e2e.js",
    "build": "npm run build:kotlin && npm run build:fsharp && npm run docs:build",
    "build:kotlin": "cd apps/grokking-ml-kotlin && ./gradlew jar",
    "build:fsharp": "cd apps/grokking-ml-fsharp && dotnet build",
    "release:dry-run": "gulp release:dry-run",
    "release:preflight": "gulp release:preflight",
    "release:patch": "gulp release:patch",
    "release:minor": "gulp release:minor",
    "release:major": "gulp release:major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k2works/{project_name}.git"
  },
  "keywords": [
    "ai",
    "programming",
    "learning"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/k2works/{project_name}/issues"
  },
  "homepage": "https://github.com/k2works/{project_name}#readme",
  "type": "module",
  "dependencies": {
    "dotenv": "^17.2.3",
    "gulp": "^5.0.0",
    "marked": "^18.0.9",
    "plantuml-encoder": "^1.4.0"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.18.1"
  }
}
