<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Deedle 8.0.0 が FSharp.Core >= 10.1.201 を要求する。SDK 同梱の 10.0.100 のままだと
         NU1605（ダウングレード）警告が出るので、暗黙参照を切って明示的に固定する。 -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.400" />
    <Compile Include="EnvironmentTests.fs" />
    <Compile Include="Nb01LinearRegressionTests.fs" />
    <Compile Include="Nb02HousePricesTests.fs" />
    <Compile Include="Nb03PolynomialRegularizationTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GrokkingMlLib\GrokkingMlLib.fsproj" />
  </ItemGroup>

</Project>